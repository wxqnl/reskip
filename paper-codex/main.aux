\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces \textbf  {Decision-rule and threshold-rule ablation on $340$M from-scratch \textsc  {AttnRes}{}}, lm-evaluation-harness with $\mathcal  {P}{=}\{3,5\}, M_{\qopname  \relax m{max}}{=}1$. Dynamic rules whose threshold actually fires on the eval distribution (B$2.$c) preserve LAMBADA at $0.345$ vs.\ static / random at the same $\sim $$12\%$ rate ($0.22$--$0.26$). Dynamic rules whose calibrated thresholds rarely cross on lm-eval data (B$1.$b at $3.1\%$ observed; B$2.$b at $0.0\%$, see Tab.\nobreakspace  {}\ref  {tab:b1b2_observed_rate}) are nearly equivalent to no-skip and are not the rate-matched comparison.\relax }}{18}{table.caption.22}\protected@file@percent }
\newlabel{tab:b1b2_decision_rule}{{14}{18}{\textbf {Decision-rule and threshold-rule ablation on $340$M from-scratch \attnres {}}, lm-evaluation-harness with $\mathcal {P}{=}\{3,5\}, M_{\max }{=}1$. Dynamic rules whose threshold actually fires on the eval distribution (B$2.$c) preserve LAMBADA at $0.345$ vs.\ static / random at the same $\sim $$12\%$ rate ($0.22$--$0.26$). Dynamic rules whose calibrated thresholds rarely cross on lm-eval data (B$1.$b at $3.1\%$ observed; B$2.$b at $0.0\%$, see Tab.~\ref {tab:b1b2_observed_rate}) are nearly equivalent to no-skip and are not the rate-matched comparison.\relax }{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces \textbf  {Observed skip rate on $8\times 512$ LAMBADA tokens.} The calibration set (FineWeb-Edu) and the eval set (LAMBADA) have different routing-statistic distributions; B$2.$b's \texttt  {entropy\_lt} threshold never fires on LAMBADA and B$1.$b fires only $3.1\%$, so their headline-table accuracy is misleadingly close to no-skip. B$2.$c is the strategy whose calibration target ($\sim $$12.5\%$) actually transfers, and is therefore the load-bearing rate-matched comparison against B$1.$c/d/e in Tab.\nobreakspace  {}\ref  {tab:b1b2_decision_rule}.\relax }}{18}{table.caption.23}\protected@file@percent }
\newlabel{tab:b1b2_observed_rate}{{15}{18}{\textbf {Observed skip rate on $8\times 512$ LAMBADA tokens.} The calibration set (FineWeb-Edu) and the eval set (LAMBADA) have different routing-statistic distributions; B$2.$b's \texttt {entropy\_lt} threshold never fires on LAMBADA and B$1.$b fires only $3.1\%$, so their headline-table accuracy is misleadingly close to no-skip. B$2.$c is the strategy whose calibration target ($\sim $$12.5\%$) actually transfers, and is therefore the load-bearing rate-matched comparison against B$1.$c/d/e in Tab.~\ref {tab:b1b2_decision_rule}.\relax }{table.caption.23}{}}
