\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {\textsc  {AR-Retrofit}{} on Qwen3-VL-2B/4B at the canonical $L{=}4$ recipe} (\texttt  {lmms-eval} full splits for VLM, $n{=}2000$ for LAMBADA/HellaSwag). The retrofit improves base on $5/6$ VLM benchmarks at both scales, with mean VLM gains of $+2.1$pp on $2$B and $+1.2$pp on $4$B, and lifts text on LAMBADA. MMStar overall holds; the math sub-category (Appendix\nobreakspace  {}\ref  {app:mmstar_subcat}) jumps $+7.9$pp on $2$B / $+3.9$pp on $4$B, consistent with a router that lifts deliberate-reasoning paths. Auxiliary parameter-matched LoRA controls do not show the same text-gain pattern (Appendix\nobreakspace  {}\ref  {app:lora_baselines}).\relax }}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:retrofit_main}{{2}{6}{\textbf {\retrofit {} on Qwen3-VL-2B/4B at the canonical $L{=}4$ recipe} (\texttt {lmms-eval} full splits for VLM, $n{=}2000$ for LAMBADA/HellaSwag). The retrofit improves base on $5/6$ VLM benchmarks at both scales, with mean VLM gains of $+2.1$pp on $2$B and $+1.2$pp on $4$B, and lifts text on LAMBADA. MMStar overall holds; the math sub-category (Appendix~\ref {app:mmstar_subcat}) jumps $+7.9$pp on $2$B / $+3.9$pp on $4$B, consistent with a router that lifts deliberate-reasoning paths. Auxiliary parameter-matched LoRA controls do not show the same text-gain pattern (Appendix~\ref {app:lora_baselines}).\relax }{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Quality--skip behavior after retrofit.} LAMBADA-$500$ on the canonical $L{=}4$ 2B retrofit, $\mathcal  {P}{=}\{1,4\}$, $M_{\qopname  \relax m{max}}{=}2$, with thresholds calibrated on $32$ held-out LAMBADA prefixes. The conservative point preserves quality while producing input-dependent block skipping; lower thresholds show the expected calibration boundary.\relax }}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:retrofit_reskip_main}{{3}{6}{\textbf {Quality--skip behavior after retrofit.} LAMBADA-$500$ on the canonical $L{=}4$ 2B retrofit, $\mathcal {P}{=}\{1,4\}$, $M_{\max }{=}2$, with thresholds calibrated on $32$ held-out LAMBADA prefixes. The conservative point preserves quality while producing input-dependent block skipping; lower thresholds show the expected calibration boundary.\relax }{table.caption.5}{}}
