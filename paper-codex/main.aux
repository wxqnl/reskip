\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Block partition sweep (v3 recipe, $r{=}256$, $\gamma $-curriculum). $L$ is layers-per-block, $N{=}L_{\text  {total}}/L$. Per-layer $L{=}1$ underperforms by $2$--$9$pp; the plateau $L\in \{2,4,7\}$ on $2$B reproduces \citet  {chen2026attnres}'s $S\in \{2,4,8\}$. We recommend $L{=}4$ on both scales because it preserves quality while reducing router calls.\relax }}{21}{table.caption.32}\protected@file@percent }
\newlabel{tab:block_partition}{{19}{21}{Block partition sweep (v3 recipe, $r{=}256$, $\gamma $-curriculum). $L$ is layers-per-block, $N{=}L_{\text {total}}/L$. Per-layer $L{=}1$ underperforms by $2$--$9$pp; the plateau $L\in \{2,4,7\}$ on $2$B reproduces \citet {chen2026attnres}'s $S\in \{2,4,8\}$. We recommend $L{=}4$ on both scales because it preserves quality while reducing router calls.\relax }{table.caption.32}{}}
